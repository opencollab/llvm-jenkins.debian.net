# Example configuration file for the jenkins-debian-glue software.
# Install this file as /etc/jenkins/debian_glue to enable it.

# Set GnuPG ID that should be used for signing the reprepro repository.
# If you build packages for Squeeze your reprepro repositories *MUST* be
# signed and the keyring that holds the public key (REPOSITORY_KEYRING)
# must be set.
# Expected format: DEADBEEF
KEY_ID=6084F3CF814B57C1CF12EFD515CF4D18AF4F7421
# KEY_ID=

# If TRUNK_RELEASE is set then the package(s) of the repository
# receiving the packages that are built will be copied to the
# repository specified in TRUNK_RELEASE. This provides the option
# to have all recent versions of packages in a central repository.
# TRUNK_RELEASE='release-trunk'

# If packages are build for more than one architecture you can
# decide which architecture should build the "Architecture: all"
# packages. On all other architectures only the arch specific
# packages will be build then.
# If unset it will default to the architecture of the host system.
# MAIN_ARCHITECTURE="amd64"

# Hook scripts for pbuilder/cowbuilder, used e.g. for autopkgtest.
# Point this at the live git checkout so that a plain `git pull` updates the
# hooks for the next build -- no manual copy into /usr/share is needed.
# (Default would be /usr/share/jenkins-debian-glue/pbuilder-hookdir/)
PBUILDER_HOOKDIR=/home/jenkins/llvm-jenkins.debian.net.git/pbuilder-hookdir/

# To enable a pbuilder configuration file for usage as documented
# in man pbuilder(8) under --configfile set this option.
# By default no user specific pbuilder configuration file is used.
# PBUILDER_CONFIG=/etc/jenkins/pbuilderrc

# Base directory for reprepro repositories, can be overwritten
# via REPOSITORY on demand
# Default:
# DEFAULT_REPOSITORY='/srv/repository'

# In order to keep the build versions unique and to ensure that there
# are no duplicates, the version number from the changelog is padded
# with the date and the build number.
# To override this behaviour and preserve the version number from the
# changelog, set USE_ORIG_VERSION to true.
# USE_ORIG_VERSION=true

# By default reprepro repositories are not verified but assumed to be
# trustworthy.
# Please note that if you build packages for Squeeze, the reprepro
# repositories *MUST* be signed and verifiable. I.e. you need to set
# KEY_ID and the corresponding keyring in REPOSITORY_KEYRING that
# holds the public key portion for that KEY_ID.
# REPOSITORY_KEYRING=/etc/apt/trusted.gpg.d/my-custom-keyring.gpg

# If $release is set then "${REPOSITORY}/release/${release}"
# is used as release repository. If you want to use a different
# directory set RELEASE_REPOSITORY accordingly.
# Default:
# RELEASE_REPOSITORY="${REPOSITORY}/release/${release}"

# Remove packages from a $release before processing incoming
# This allows to rebuild and provide versions already existent
# in the release repository they are built for.
# Default:
# REMOVE_FROM_RELEASE=false

# By default the underlying build system (cowbuilder/pbuilder)
# automatically destroys the build environment, even if building
# fails for whatever reason. If DEB_KEEP_BUILD_ENV is set then
# a copy of the build environment is created under
# /var/cache/pbuilder/build/debug.$JOBNAME
# Please be aware that those build environments usually require
# quite some disk space, so do not forget to remove them.
# If unset the build environment won't be kept if building fails.
# DEB_KEEP_BUILD_ENV=true

# Comma separated list of extra repositories for resolving dependencies.
# Usage example:
# REPOSITORY_EXTRA='deb http://security.debian.org/ wheezy/updates main,deb-src http://security.debian.org/ wheezy/updates main'
# Default:
# REPOSITORY_EXTRA=

# Comma separated list of URLs with keys for extra repositories.
# Usage example:
# REPOSITORY_EXTRA_KEYS='http://foorepo.domain.com/key1.gpg,http://barrepo.domain.com/key2.gpg'
# Default:
# REPOSITORY_EXTRA_KEYS=

# autopkgtests are executed automatically inside the cowbuilder environment by
# default, corresponding to the ADT='internal' setting or if ADT is unset.
# To execute autopkgtests also externally via adt-run you need to set ADT to
# either 'external' (no internal runs) or 'all' (internal + external runs).
# The external autopkgtests depend on a configured ADT_RUNNER setting.
# To skip internal as well as external autopkgtests set ADT='skip'.
# Usage example (see adt-virt-qemu(1) for details regarding image setup):
# ADT='external'
# ADT_RUNNER="adt-virt-qemu /srv/adt-${distribution:-}-${architecture:-}.img"
# Default:
# ADT=

# Control usage of eatmydata to speed up builds. If eatmydata is present on the
# host system and when building for a recent distribution (Debian/jessie +
# Ubuntu/vivid or newer) eatmydata is enabled automatically.
# To force its usage (skipping any host + distribution checks) set it to 'true'.
# To disable its usage set it to 'false'.
# USE_EATMYDATA=true

# Enable ccache (compiler cache for fast recompilation of C/C++ code)
# to speed up builds.
#USE_CCACHE=true

# Specify the format (as accepted by the 'date' command) for the generated
# build timestamp.
# Default: %Y%m%d%H%M%S
# TIMESTAMP_FORMAT="%Y%m%d%H%M%S"

# In case you are explicitly marking your new package version as "UNRELEASED"
# inside the debian/changelog file, you may not get a package build version
# number containing the SCM commit. Set this to 'true' in order to work around
# this.
# Default: false
# UNRELEASED_APPEND_COMMIT=false

# ---------------------------------------------------------------------------
# Not upstream config: this file is sourced as shell by the
# jenkins-debian-glue scripts on the host, so it can also carry node fixups.
#
# On the s390x node (llvm04) /srv/repository is a separate filesystem and has
# been seen unmounted (2026-08-05): every build then succeeds but the final
# deploy bails out with
# "Error: repository /srv/repository/<suite> does not exist."
# Remount it here, before the build starts, so the publish step finds it.
# Needs an /etc/fstab entry for /srv/repository on the node; jenkins already
# has sudo for cowbuilder. A pbuilder hook cannot do this job -- hooks run
# inside the chroot, where neither the mount point nor the fstab entry exist.
if [ "$(dpkg --print-architecture 2>/dev/null)" = "s390x" ] \
   && ! mountpoint -q /srv/repository 2>/dev/null; then
    echo "WARNING: /srv/repository is not mounted; attempting to mount it"
    if sudo -n mount /srv/repository; then
        echo "INFO: mounted /srv/repository"
    else
        echo "WARNING: could not mount /srv/repository - the final deploy will bail out"
    fi
fi

# The arm64 agents are provisioned per build (random-suffix names, workspace
# under /tmp) and /srv/repository comes up root-owned (2026-08-04..08): the
# build succeeds but every publish-step reprepro call dies with
# "Error 13 creating lock file '/srv/repository/<suite>/db/lockfile':
# Permission denied!". The real fix is the agent image; until that lands,
# hand the tree to the build user here, before the build starts. Checks the
# per-suite db/ dirs too, in case only the subtree is root-owned.
if [ "$(dpkg --print-architecture 2>/dev/null)" = "arm64" ] \
   && [ -d /srv/repository ]; then
    need_chown=no
    [ -w /srv/repository ] || need_chown=yes
    for d in /srv/repository/*/db; do
        if [ -d "$d" ] && [ ! -w "$d" ]; then
            need_chown=yes
        fi
    done
    if [ "$need_chown" = "yes" ]; then
        echo "WARNING: /srv/repository is not writable by $(id -un); attempting to chown it"
        if sudo -n chown -R "$(id -un):" /srv/repository; then
            echo "INFO: chowned /srv/repository to $(id -un)"
        else
            echo "WARNING: could not chown /srv/repository - the publish step will fail"
        fi
    fi
    unset need_chown
fi

# Real arch list for generate-reprepro-codename, whose "amd64 i386 source" default
# built a stanza rejecting the s390x .debs (2026-08-12, focal-23). i386: Debian only.
if [ -z "${ARCHITECTURES:-}" ] && [ -n "${REPOSITORY:-}" ]; then
    case "$(basename "$REPOSITORY")" in
        unstable|buster|bullseye|bookworm|trixie)
            ARCHITECTURES="amd64 i386 source s390x arm64"
            ;;
        *)
            ARCHITECTURES="amd64 source s390x arm64"
            ;;
    esac
    echo "INFO: ARCHITECTURES set to [$ARCHITECTURES] for $REPOSITORY"
fi

# ---------------------------------------------------------------------------
# cowbuilder base self-heal (2026-09-03, llvm-toolchain-noble-23-binaries/s390x
# build 31). The refresh of an existing base died before any build started:
#
#   I: redirecting /dev/ptmx to /dev/pts/ptmx
#   mount: /var/cache/pbuilder/build/cow.N/dev/ptmx: mount point does not exist.
#   E: pbuilder update failed
#   E: Something (/var/cache/pbuilder/build/cow.N/proc) is still mounted under
#      /var/cache/pbuilder/build/cow.N; unmount and remove ... manually
#   Error: Failed to update cowbuilder base /var/cache/pbuilder/base-noble-s390x.cow.
#
# Two things went wrong, and the glue turned both into a hard failure:
#   * base-<dist>-<arch>.cow had lost /dev/ptmx, which pbuilder bind-mounts
#     unless it is a symlink. Deterministic: every later build hits it too.
#   * the failed run left /proc & co. mounted under build/cow.N, so cowbuilder
#     could not remove its copy, and neither can clean-pbuilder.sh.
#
# Upstream's cowbuilder_init() runs the create/update exactly once and calls
# bailout on any error. This file is sourced by checks_and_defaults(), i.e.
# after that function is defined and before it runs, so it can be wrapped:
#   1. preflight: unmount + remove build/cow.N copies whose cowbuilder is gone,
#      and put back the device nodes pbuilder expects in the base;
#   2. run the upstream create/update in a subshell so its bailout does not
#      end the job; on failure, preflight again and retry once. Upstream sets
#      the global $pbuilderrc in there, which cowbuilder_run() needs later
#      (set -u: "pbuilderrc: unbound variable"), so it is handed back out;
#   3. if the *update* still fails, delete the base and let the upstream code
#      recreate it from scratch with the current pbuilderrc (this also covers
#      a base whose baked-in sources.list points at a mirror that dropped the
#      suite -- the buster case of 2026-08-11);
#   4. only then fail, with the same message as before so the dashboard's
#      cowbuilder-create rule keeps matching.
# Everything under /var/cache/pbuilder is root's, hence sudo -n throughout;
# when sudo is refused the step is skipped with a warning and the upstream
# behaviour is what remains.

_cow_sudo() {
    sudo -n "$@"
}

# Print the mount points below $1, deepest first (they must go in that order).
_cow_mounts_under() {
    awk -v root="$1" '$2 == root || index($2, root "/") == 1 { print $2 }' /proc/mounts \
        | sort -r
}

# $1 = build/cow.N directory. True when the cowbuilder that owns it (its PID
# is the N) is no longer running. Ask as root: on a node with proc hidepid,
# jenkins cannot see root's processes and would otherwise declare every live
# build stale.
_cow_dir_is_stale() {
    local pid=${1##*/cow.}
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    if _cow_sudo test -d "/proc/$pid" 2>/dev/null; then
        return 1
    fi
    # Belt and braces: never touch a copy that changed in the last 10 minutes.
    [ -z "$(find "$1" -maxdepth 0 -mmin -10 2>/dev/null)" ]
}

cowbuilder_preflight() {
    local base cow mnt failed d

    # 1. Leftovers of an aborted create/update/build.
    for cow in /var/cache/pbuilder/build/cow.*; do
        [ -d "$cow" ] || continue
        _cow_dir_is_stale "$cow" || continue
        failed=""
        for mnt in $(_cow_mounts_under "$cow"); do
            echo "WARNING: $mnt is still mounted from a dead cowbuilder run; unmounting"
            _cow_sudo umount "$mnt" 2>/dev/null \
                || _cow_sudo umount -l "$mnt" 2>/dev/null \
                || failed=1
        done
        if [ -n "$failed" ]; then
            echo "WARNING: could not unmount everything under $cow, leaving it alone"
            continue
        fi
        echo "INFO: removing stale build copy $cow"
        _cow_sudo rm -rf "$cow" || echo "WARNING: could not remove $cow"
    done

    # 2. Device nodes in the base image. pbuilder itself creates /dev/console
    # when missing but bind-mounts /dev/pts/ptmx over /dev/ptmx and fails when
    # the target is gone -- a symlink is what it skips, and what devtmpfs
    # ships anyway. Path mirrors dist_and_arch_settings() in the glue.
    base=${COWBUILDER_BASE:-/var/cache/pbuilder/base-${COWBUILDER_DIST:-${distribution:-}}-${architecture:-$(dpkg --print-architecture 2>/dev/null)}.cow}
    [ -d "$base/dev" ] || return 0
    if [ ! -e "$base/dev/ptmx" ] && [ ! -L "$base/dev/ptmx" ]; then
        echo "WARNING: $base/dev/ptmx is missing; recreating it as a symlink to pts/ptmx"
        _cow_sudo ln -s pts/ptmx "$base/dev/ptmx" \
            || echo "WARNING: could not create $base/dev/ptmx - the base refresh will fail"
    fi
    for d in pts shm; do
        if [ ! -d "$base/dev/$d" ]; then
            echo "WARNING: $base/dev/$d is missing; recreating it"
            _cow_sudo mkdir -p "$base/dev/$d" \
                || echo "WARNING: could not create $base/dev/$d"
        fi
    done
    # /dev/null is what every hook and apt run needs first; the rest pbuilder
    # can live without.
    if [ ! -c "$base/dev/null" ]; then
        echo "WARNING: $base/dev/null is missing; recreating it"
        _cow_sudo rm -f "$base/dev/null" 2>/dev/null
        _cow_sudo mknod -m 666 "$base/dev/null" c 1 3 \
            || echo "WARNING: could not create $base/dev/null"
    fi
}

# One upstream cowbuilder_init in a subshell, copying the $pbuilderrc it
# created back into this shell on success.
_cow_attempt() {
    local state rc
    state=$(mktemp) || return 1
    ( upstream_cowbuilder_init && printf '%s' "${pbuilderrc:-}" > "$state" )
    rc=$?
    [ $rc -eq 0 ] && [ -s "$state" ] && pbuilderrc=$(cat "$state")
    rm -f "$state"
    return $rc
}

if declare -F cowbuilder_init >/dev/null 2>&1 \
   && ! declare -F upstream_cowbuilder_init >/dev/null 2>&1; then
    eval "upstream_$(declare -f cowbuilder_init)"

    cowbuilder_init() {
        cowbuilder_preflight
        # Subshell: upstream's bailout only ends the attempt, not the job. It
        # still removes the update lock files it created, so a retry is not
        # skipped as "already taking place".
        _cow_attempt && return 0

        echo "WARNING: cowbuilder base create/update failed; cleaning up and retrying once"
        cowbuilder_preflight
        _cow_attempt && return 0

        if [ -d "${COWBUILDER_BASE}" ]; then
            echo "WARNING: refreshing ${COWBUILDER_BASE} failed twice; rebuilding it from scratch"
            if _cow_sudo rm -rf "${COWBUILDER_BASE}"; then
                _cow_attempt && return 0
            else
                echo "WARNING: could not remove ${COWBUILDER_BASE}"
            fi
            bailout 1 "Error: Failed to update cowbuilder base ${COWBUILDER_BASE}."
        fi
        bailout 1 "Error: Failed to create cowbuilder base ${COWBUILDER_BASE}."
    }
fi
